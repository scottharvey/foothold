<% content_for :title, "Rivals" %>
<%= render "foothold/shared/header" %>

<%= render Ui::IndexHeaderComponent.new(title: "Rivals", subtitle: "Domains whose ranking terms are compared with yours each week") %>

<%= form_with url: rivals_path, method: :post, class: "flex flex-wrap items-end gap-2 mb-4" do |f| %>
  <fieldset class="fieldset">
    <label class="label" for="rival_domain">Add a rival</label>
    <%= f.text_field "rival[domain]", id: "rival_domain", placeholder: "e.g. example.com", class: "input input-sm w-72", required: true, **plain_field %>
  </fieldset>
  <%= f.submit "Add", class: "btn btn-sm" %>
<% end %>

<% if @rivals.empty? %>
  <%= render Ui::EmptyStateComponent.new(title: "No rivals yet", description: "Add a competitor domain above to compare its ranking terms with yours.") %>
<% else %>
  <ul class="list rounded-box bg-base-100 shadow-sm">
    <% @rivals.each do |rival| %>
      <li class="list-row items-center">
        <div class="font-medium"><%= rival.domain %></div>
        <div class="text-xs opacity-60">
          <%= @rival_counts.fetch(rival.id, 0) %> ranking <%= "term".pluralize(@rival_counts.fetch(rival.id, 0)) %>
          <%= " · checked #{foothold_ago(rival.last_checked_at)}" if rival.last_checked_at %>
        </div>
        <div>
          <%= button_to "Remove", rival_path(rival), method: :delete, class: "btn btn-ghost btn-xs text-error",
                form: { class: "inline", data: { turbo_confirm: "Remove #{rival.domain} and its ranking terms?" } } %>
        </div>
      </li>
    <% end %>
  </ul>
<% end %>
