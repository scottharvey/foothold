<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
</head>
<body style="margin:0;padding:40px 16px;background:#ffffff;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;color:#1a1a1a;">
  <table width="100%" cellpadding="0" cellspacing="0" style="max-width:560px;margin:0 auto;">
    <tr>
      <td style="padding-bottom:24px;">
        <span style="font-size:18px;font-weight:900;color:#1a1a1a;">Foothold</span>
        <div style="font-size:13px;color:#666;margin-top:2px;">Week of <%= @digest.week_starting.strftime("%-d %b %Y") %></div>
      </td>
    </tr>

    <% if @digest.movers_up.any? || @digest.movers_down.any? %>
      <tr>
        <td style="padding-bottom:20px;font-size:15px;line-height:1.6;">
          <strong>Movers</strong>
          <% @digest.movers_up.each do |mover| %>
            <p style="margin:8px 0 0;color:#0a7a3d;">▲ “<%= mover["phrase"] %>” <%= mover["before"] %> → <%= mover["after"] %></p>
          <% end %>
          <% @digest.movers_down.each do |mover| %>
            <p style="margin:8px 0 0;color:#b3261e;">▼ “<%= mover["phrase"] %>” <%= mover["before"] %> → <%= mover["after"] %></p>
          <% end %>
        </td>
      </tr>
    <% end %>

    <% if @digest.new_referrers.any? %>
      <tr>
        <td style="padding-bottom:20px;font-size:15px;line-height:1.6;">
          <strong>New referrers</strong>
          <% @digest.new_referrers.each do |referrer| %>
            <p style="margin:8px 0 0;"><%= referrer["domain"] %> — <%= referrer["visits"] %> visits, <%= referrer["signups"] %> signups</p>
          <% end %>
        </td>
      </tr>
    <% end %>

    <% if @digest.new_mentions.any? %>
      <tr>
        <td style="padding-bottom:20px;font-size:15px;line-height:1.6;">
          <strong>New mentions</strong>
          <% @digest.new_mentions.each do |mention| %>
            <p style="margin:8px 0 0;"><%= mention["title"].presence || mention["url"] %> (<%= mention["source"].humanize %>)</p>
          <% end %>
        </td>
      </tr>
    <% end %>

    <% if @digest.findings.any? %>
      <tr>
        <td style="padding-bottom:20px;font-size:15px;line-height:1.6;">
          <strong>Findings</strong>
          <% @digest.findings.each do |finding| %>
            <p style="margin:8px 0 0;"><%= finding["summary"] %></p>
          <% end %>
        </td>
      </tr>
    <% end %>

    <tr>
      <td style="font-size:15px;line-height:1.6;">
        <strong>Top leads</strong>
        <% if @digest.top_leads.any? %>
          <% @digest.top_leads.each do |lead| %>
            <p style="margin:8px 0 0;"><%= lead["summary"] %></p>
          <% end %>
        <% else %>
          <p style="margin:8px 0 0;color:#666;">Nothing open right now.</p>
        <% end %>
      </td>
    </tr>
  </table>
</body>
</html>
