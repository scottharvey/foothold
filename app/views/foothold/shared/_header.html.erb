<%= render Ui::ToolHeaderComponent.new(name: "Foothold", home_url: root_path) do |header| %>
  <% header.with_nav do %>
    <%= link_to "Queue", root_path, class: "btn btn-ghost btn-sm #{'btn-active' if controller_name == 'home'}" %>
    <%= link_to "Terms", terms_path, class: "btn btn-ghost btn-sm #{'btn-active' if controller_name == 'terms'}" %>
    <%= link_to "Rivals", rivals_path, class: "btn btn-ghost btn-sm #{'btn-active' if controller_name == 'rivals'}" %>
    <%= link_to "Mentions", mentions_path, class: "btn btn-ghost btn-sm #{'btn-active' if controller_name == 'mentions'}" %>
    <%= link_to "Mutes", mutes_path, class: "btn btn-ghost btn-sm #{'btn-active' if controller_name == 'mutes'}" %>
    <%= link_to "Sweeps", sweeps_path, class: "btn btn-ghost btn-sm #{'btn-active' if controller_name == 'sweeps'}" %>
  <% end %>
<% end %>
