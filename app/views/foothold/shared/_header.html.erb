<div class="flex flex-wrap items-center justify-between gap-3 mb-8">
  <div class="flex items-center gap-2">
    <%= link_to "Foothold", root_path, class: "text-xl font-bold" %>
    <span class="text-sm opacity-60"><%= @site&.display_name %></span>
    <nav class="flex items-center gap-1 ml-4">
      <%= link_to "Queue", root_path(anchor: "queue"), class: "btn btn-ghost btn-sm" %>
      <%= link_to "Terms", root_path(anchor: "terms"), class: "btn btn-ghost btn-sm" %>
      <%= link_to "Rivals", root_path(anchor: "rivals"), class: "btn btn-ghost btn-sm" %>
    </nav>
  </div>
  <div class="flex items-center gap-2">
    <%= button_to "Sweep now", sweep_path, method: :post, class: "btn btn-sm btn-ghost", form: { class: "inline" } %>
    <%= button_to "Weekly audit", sweep_path(kind: "weekly"), method: :post, class: "btn btn-sm btn-ghost", form: { class: "inline" } %>
    <%= button_to "Send digest now", digest_path, method: :post, class: "btn btn-sm btn-ghost", form: { class: "inline" } %>
    <%= link_to "Hub", main_app.hub_path, class: "btn btn-sm btn-ghost opacity-60" if main_app.respond_to?(:hub_path) %>
  </div>
</div>
<% if notice.present? %>
  <%= render Ui::AlertComponent.new(variant: :success, classes: "mb-4", text: notice) %>
<% end %>
<% if alert.present? %>
  <%= render Ui::AlertComponent.new(variant: :error, classes: "mb-4", text: alert) %>
<% end %>
